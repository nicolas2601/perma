# Copy to .env.local (git-ignored). Only VITE_* variables are embedded in the client bundle:
# never put secrets here. Anything in this file is public to every visitor.

# Inference source. "live" calls the backend; "mock" uses deterministic simulated values
# (each one is badged "Modelo simulado" and never exported as a real result).
# Note: the mock client is part of the planned src/core/inference module, not yet in this branch.
VITE_INFERENCE=live

# Live model for the seven-class HAM interface. Legacy IDs are mock-only.
VITE_DEFAULT_MODEL=MOCO_HAM7

# Dev-server proxy target for /api. Leave empty to use https://derm.nicolasmoreno.site.
# Gotcha: vite.config.ts reads process.env, not .env files, so this value only applies when
# it is exported in the shell (VITE_API_ORIGIN=... npm run dev). See README.
VITE_API_ORIGIN=
