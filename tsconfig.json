{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023","DOM","DOM.Iterable","WebWorker"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true, "types": ["vite/client","vite-plugin-pwa/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src","tests","vite.config.ts","vitest.config.ts","playwright.config.ts","playwright.flows.config.ts"]
}
