# EXAMPLE, NOT DEPLOYED. Serves dist/ and reverse-proxies /api to the inference backend.
# Placeholders: perma.example.com, certificate paths, dist path. Validate with `nginx -t`.
# Unverified against a live nginx in this repo: check headers with `curl -sI https://<host>/`.

server {
  listen 443 ssl;
  http2 on;
  server_name perma.example.com;

  ssl_certificate     /etc/letsencrypt/live/perma.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/perma.example.com/privkey.pem;

  root /var/www/perma/dist;
  index index.html;

  # Security headers. In nginx, a location that declares its own add_header drops the
  # server-level ones, so the locations below repeat what they need.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; worker-src 'self' blob:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Content-Type-Options "nosniff" always;

  # Backend: same origin for the browser (connect-src 'self'), never cached.
  location /api/ {
    proxy_pass https://derm.nicolasmoreno.site;
    proxy_ssl_server_name on;
    proxy_set_header Host derm.nicolasmoreno.site;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;   # no verificado: set to the backend's real predict latency
    add_header Cache-Control "no-store" always;
  }

  # Content-hashed bundles and fonts: cache for a year.
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; worker-src 'self' blob:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  }

  location ~ ^/workbox-[0-9a-f]+\.js$ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  # Must revalidate: the shell and the service worker decide what users run.
  location = /index.html {
    add_header Cache-Control "no-store" always;
  }

  location = /sw.js {
    add_header Cache-Control "no-store" always;
  }

  location = /registerSW.js {
    add_header Cache-Control "no-cache" always;
  }

  location = /manifest.webmanifest {
    add_header Cache-Control "no-cache" always;
  }

  # SPA fallback for client-side routes. Runs after the static files above.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache" always;
  }
}

server {
  listen 80;
  server_name perma.example.com;
  return 301 https://$host$request_uri;
}
